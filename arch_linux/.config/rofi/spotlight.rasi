configuration {
    show-icons: true;
    display-drun: "🔍";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
}

* {
    font: "JetBrainsMono Nerd Font 14";
    bg0:  #050505E6;
    bg1:  #1A1A1AE6;
    fg0:  #FFFFFF;
    fg1:  #A0A0A0;
    accent: #ff003c;
    
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
}

window {
    background-color: @bg0;
    border: 2px solid @accent;
    border-radius: 15px;
    width: 700px;
    padding: 20px;
    box-shadow: 0px 5px 20px rgba(255, 0, 60, 0.4);
}

mainbox {
    spacing: 15px;
}

inputbar {
    background-color: @bg1;
    border-radius: 10px;
    padding: 12px 15px;
    spacing: 10px;
    children: [ prompt, entry ];
    border: 1px solid rgba(255, 0, 60, 0.2);
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font 16";
}

entry {
    placeholder: "Pesquisar apps, arquivos ou web...";
    placeholder-color: @fg1;
    text-color: @fg0;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 5px;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 10px 15px;
    border-radius: 8px;
    spacing: 15px;
}

element normal normal, element alternate normal {
    background-color: transparent;
}

element selected {
    background-color: rgba(255, 0, 60, 0.2);
    border: 1px solid @accent;
    text-color: @accent;
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
}
