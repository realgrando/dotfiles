* {
    bg-col:  rgba(26, 27, 38, 0.85);
    bg-col-light: rgba(41, 46, 66, 0.95);
    border-col: #7aa2f7;
    selected-col: rgba(122, 162, 247, 0.3);
    blue: #7aa2f7;
    fg-col: #c0caf5;
    fg-col2: #f7768e;
    grey: #565f89;
    
    width: 600;
    background-color: transparent;
}

window {
    height: 400px;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    background-color: @bg-col;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 10px;
    margin: 20px 20px 10px 20px;
}

prompt {
    background-color: transparent;
    text-color: @blue;
    padding: 5px 15px 5px 10px;
    font: "JetBrainsMono Nerd Font bold 14";
}

entry {
    background-color: transparent;
    text-color: @fg-col;
    placeholder: "Search...";
    placeholder-color: @grey;
    padding: 5px 0px;
    font: "JetBrainsMono Nerd Font 14";
}

listview {
    border: 0px;
    padding: 10px 20px 20px 20px;
    margin: 0px;
    background-color: transparent;
    columns: 2;
    spacing: 10px;
}

element {
    padding: 10px;
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 8px;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    margin: 0px 0px 0px 15px;
}

element selected {
    background-color: @selected-col;
    text-color: @blue;
    border: 1px;
    border-color: @blue;
}
