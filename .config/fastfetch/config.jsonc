{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/asce/.config/fastfetch/spiderman.txt",
    "color": {
      "1": "red"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰁕 ",
    "disableLinewrap": true,
    "color": {
      "keys": "red"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": " OS",
      "keyColor": "red",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": " KER",
      "keyColor": "red",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "󰏗 PKG",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": " SH",
      "keyColor": "red",
      "format": "{1}"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "red",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "red",
      "format": "{1}"
    },
    {
      "type": "memory",
      "key": " RAM",
      "keyColor": "red",
      "format": "{1}/{2}"
    },
    {
      "type": "uptime",
      "key": "󰅐 UP",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
