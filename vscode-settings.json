{
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontSize": 16,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "workbench.startupEditor": "terminal",
    "editor.renderLineHighlight": "none",
    "workbench.editor.labelFormat": "short",
    "explorer.compactFolders": false,
    "editor.semanticHighlighting.enabled": false,
    "breadcrumbs.enabled": false,
    "workbench.activityBar.location": "hidden", //side menu
    "editor.minimap.enabled": false,
    "editor.scrollbar.vertical": "hidden",
    "editor.scrollbar.horizontal": "hidden",
    "workbench.statusBar.visible": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false, 
    "window.titleBarStyle": "native",
    "window.menuBarVisibility": "hidden",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontSize": 16,
    
    "workbench.colorCustomizations": {
        "sideBar.background": "#080807",
        "sideBar.foreground": "#e3edb0",
        "sideBar.border": "#121212",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.foreground": "#e3edb0",
        "sideBarSectionHeader.border": "#000000",
        "sideBarTitle.foreground": "#4dff0000",
        

        "editor.background": "#0d0d0d",
        "editor.selectionBackground": "#2485fc69",
        "editorCursor.foreground": "#939393",
        "editorLineNumber.background": "#000000",
        "editorLineNumber.foreground": "#272727a7",
        "editorLineNumber.activeForeground": "#939393b0",

        
        "terminal.background": "#0b0b0b",
        "terminal.foreground": "#383835",
        "terminalCursor.background": "#00ff3c",
        "terminalCursor.foreground": "#00ff3c",
        "panel.background": "#0b0b0b",
        "panel.border": "#0b0b0b",

        "tab.activeBackground": "#0c0c0c",
        "tab.inactiveBackground": "#101010",
        "tab.activeForeground": "#313131",
        "tab.inactiveForeground": "#2b2b2b",
        "tab.border": "#0d0d0d",
        "tab.activeBorder": "#1f1f1f5d",
        "tab.activeBorderTop": "#1f1f1f5d",
        "tab.activeBorderBottom": "#1f1f1f5d",
        "editorGroupHeader.tabsBackground": "#0d0d0d",
        "editorGroupHeader.tabsBorder": "#1f1f1f5d",

        "editorIndentGuide.activeBackground1": "#1f1f1f5d",
        "editorIndentGuide.activeBackground2": "#1f1f1f5d",
        "editorIndentGuide.activeBackground3": "#1f1f1f5d",
        "editorIndentGuide.activeBackground4": "#1f1f1f5d",
        "editorIndentGuide.activeBackground5": "#1f1f1f5d",
        "editorIndentGuide.activeBackground6": "#1f1f1f5d",
        "editorIndentGuide.background1": "#1f1f1f5d",
        "editorIndentGuide.background2": "#1f1f1f5d",
        "editorIndentGuide.background3": "#1f1f1f5d",
        "editorIndentGuide.background4": "#1f1f1f5d",
        "editorIndentGuide.background5": "#1f1f1f5d",
        "editorIndentGuide.background6": "#1f1f1f5d",   
    },
    "workbench.editor.editorActionsLocation": "hidden",
    "window.title": "Code",
    "workbench.iconTheme": "material-icon-theme",
    "window.openFoldersInNewWindow": "off",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "workbench.colorTheme": "Omni"
    
}   
